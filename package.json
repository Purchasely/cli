{
  "name": "@purchasely/cli",
  "version": "0.5.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Purchasely command line tool, generated from the Management OpenAPI spec",
  "type": "module",
  "bin": {
    "purchasely": "dist/bin/purchasely.js"
  },
